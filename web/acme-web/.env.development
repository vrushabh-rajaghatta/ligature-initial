# Loaded automatically by `npm run dev`. The API's Development profile listens
# here (src/Host/Acme.Api/Properties/launchSettings.json), and Program.cs allows
# CORS with credentials from http://localhost:5173 — the two must agree, or the
# session cookie is withheld and every request looks unauthenticated.
VITE_API_BASE_URL=http://localhost:5225
