# Copy to `.env.production` (or set in your host's environment) when deploying.
#
# Where the API lives, with no trailing slash. Every request path already starts
# with `/api`, so this is origin only.
#
# Leave it EMPTY when the API is served from the same origin as this app — the
# requests then go to /api/... relative to wherever the page was loaded from,
# which is what you want behind one reverse proxy.
VITE_API_BASE_URL=https://api.example.com
