{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Acme": "Host=localhost;Port=5432;Database=acme;Username=postgres;Password=postgres"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "SigningKey": "development-only-key-never-use-outside-local-development",
    "Issuer": "acme-development",
    "Audience": "acme-development",
    "AccessTokenMinutes": 15
  },
  "RefreshToken": {
    "Days": 14
  },
  "Invitation": {
    "Days": 7,
    "AcceptUrl": "http://localhost:5173/accept-invitation"
  },
  "PasswordReset": {
    "Minutes": 60,
    "CompleteUrl": "http://localhost:5173/reset-password"
  }
}
